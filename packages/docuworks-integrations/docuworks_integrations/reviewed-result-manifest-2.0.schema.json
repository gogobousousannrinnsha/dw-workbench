{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviewed-result-manifest 2.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "docuworks-reviewed-result"
    },
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "const": "COMPLETE"
    },
    "files": {
      "type": "object",
      "properties": {
        "identity.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source-review.xdw": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity.json",
        "session.json",
        "reviewed.json",
        "reviewed.jsonl",
        "source-review.xdw"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "schema_version",
    "status",
    "files"
  ],
  "additionalProperties": false
}
