{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-session-identity 1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "docuworks-review-session-identity"
    },
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "canonical_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "width_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "annotation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "region_id": {
                  "type": "string",
                  "pattern": "^p[0-9]{4,}-r[0-9]{6,}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "annotation_id",
                "region_id",
                "text",
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "page",
          "page_id",
          "width_mm",
          "height_mm",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "schema_version",
    "review_id",
    "run_id",
    "canonical_manifest_sha256",
    "source_sha256",
    "pages"
  ],
  "additionalProperties": false
}
