{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected-region OCR XDW review 2.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "review_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "const": "docuworks-ocr-review"
        },
        "status": {
          "const": "COMPLETE"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "review_page": {
          "const": 1
        },
        "page_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "page_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "annotation_count": {
          "type": "integer",
          "minimum": 1
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "region_id": {
                "type": "string",
                "pattern": "^p[0-9]{4,}-r[0-9]{6,}$"
              },
              "original_text": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "region_id",
              "original_text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "review_id",
        "run_id",
        "manifest_sha256",
        "schema",
        "status",
        "source_page",
        "review_page",
        "page_width_mm",
        "page_height_mm",
        "annotation_count",
        "regions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "review_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "region_id": {
          "type": "string",
          "pattern": "^p[0-9]{4,}-r[0-9]{6,}$"
        },
        "schema": {
          "const": "docuworks-ocr-review-identity"
        },
        "review_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "review_id",
        "run_id",
        "manifest_sha256",
        "region_id",
        "schema",
        "review_manifest_sha256"
      ],
      "additionalProperties": false
    }
  ]
}
