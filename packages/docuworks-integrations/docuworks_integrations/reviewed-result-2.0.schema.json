{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviewed-result 2.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "docuworks-reviewed-result"
    },
    "schema_version": {
      "const": "2.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_xdw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinate_system": {
      "const": "top-left-x-right-y-down"
    },
    "unit": {
      "const": "mm"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "width_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rotation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 359
                },
                "direction": {
                  "enum": [
                    0,
                    1
                  ]
                },
                "diagnostics": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "EMPTY_TEXT",
                      "ORIGIN_INVALID",
                      "ORIGIN_FOREIGN",
                      "ORIGIN_PARTIAL"
                    ]
                  }
                },
                "origins": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "properties": {
                      "run_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "canonical_manifest_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "region_id": {
                        "type": "string",
                        "pattern": "^p[0-9]{4,}-r[0-9]{6,}$"
                      }
                    },
                    "required": [
                      "run_id",
                      "canonical_manifest_sha256",
                      "region_id"
                    ],
                    "additionalProperties": false
                  }
                },
                "origin_evidence": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "none",
                        "matched",
                        "invalid",
                        "foreign",
                        "partial"
                      ]
                    },
                    "raw_base64": {
                      "anyOf": [
                        {
                          "type": "string",
                          "contentEncoding": "base64"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 2147483647
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "reason": {
                            "enum": [
                              "invalid",
                              "foreign"
                            ]
                          }
                        },
                        "required": [
                          "index",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "raw_base64",
                    "issues"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "item_id",
                "order",
                "text",
                "x",
                "y",
                "width",
                "height",
                "rotation",
                "direction",
                "diagnostics",
                "origins",
                "origin_evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "page",
          "page_id",
          "width_mm",
          "height_mm",
          "rotation",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "validation": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "identity"
        },
        "identity_checked": {
          "const": true
        },
        "page_structure_checked": {
          "const": false
        }
      },
      "required": [
        "mode",
        "identity_checked",
        "page_structure_checked"
      ],
      "additionalProperties": false
    },
    "excluded_sticky_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "schema",
    "schema_version",
    "result_id",
    "review_id",
    "created_at",
    "source_xdw_sha256",
    "session_sha256",
    "coordinate_system",
    "unit",
    "pages",
    "validation",
    "excluded_sticky_count"
  ],
  "additionalProperties": false
}
