{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "structured-result-manifest-1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "docuworks-structured-result"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "COMPLETE"
    },
    "files": {
      "type": "object",
      "properties": {
        "identity.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed-manifest.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template-manifest.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity.json",
        "reviewed-manifest.json",
        "reviewed.json",
        "session.json",
        "structured.json",
        "structured.jsonl",
        "template-manifest.json",
        "template.json"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "schema_version",
    "status",
    "files"
  ],
  "additionalProperties": false
}
