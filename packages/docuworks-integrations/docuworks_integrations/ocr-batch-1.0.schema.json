{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocuWorks OCR Batch 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "batch_id", "input_dir", "settings", "documents", "status", "started_at", "finished_at", "elapsed_seconds", "error"],
  "properties": {
    "schema": {"const": "docuworks-ocr-batch"},
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "format": "uuid"},
    "input_dir": {"type": "string"},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["recursive", "dpi", "pages", "model_root", "dll_path"],
      "properties": {
        "recursive": {"type": "boolean"}, "dpi": {"enum": [300, 600]},
        "pages": {"const": "all"}, "model_root": {"type": "string"},
        "dll_path": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["RUNNING", "COMPLETE", "PARTIAL_FAILED", "FAILED", "INTERRUPTED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "error": {"$ref": "#/$defs/error"},
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["document_id", "source_relative_path", "run_dir", "status", "run_id", "source_sha256", "page_count", "elapsed_seconds", "error"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^doc-[0-9]{6,}$"},
          "source_relative_path": {"type": "string", "minLength": 1},
          "run_dir": {"type": "string", "pattern": "^runs/doc-[0-9]{6,}$"},
          "status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"]},
          "run_id": {"type": ["string", "null"], "format": "uuid"},
          "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "page_count": {"type": ["integer", "null"], "minimum": 1},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "error": {"$ref": "#/$defs/error"}
        }
      }
    }
  },
  "$defs": {
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["type", "message", "scope", "phase"],
         "properties": {
           "type": {"type": "string"}, "message": {"type": "string"},
           "scope": {"enum": ["document", "batch", "interrupted"]},
           "phase": {"type": ["string", "null"]}
         }}
      ]
    }
  }
}
